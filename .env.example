# Optional developer settings. The desktop app gets its keys from Settings > Connections.
# To use this for evals, copy it to .env, uncomment the settings you want, and run:
# (set -a && . ./.env && npm run eval)

# Use your own Gateway key for evals. Leave unset to use Spawner's saved connection.
# AI_GATEWAY_API_KEY=''

# Override model settings when supplying your own Gateway key.
# SPAWNER_EVAL_SETTINGS='{"decisionModel":"typesafe-ai/jev-1.14.0"}'

# Run just one evaluation suite.
# SPAWNER_EVAL_SUITE='Delegated requests'

# For an isolated Electron smoke test, choose a dedicated temporary data folder:
# SPAWNER_TEST_DATA="$(mktemp -d)" npm run smoke
